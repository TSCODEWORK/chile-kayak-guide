# Cloudflare Pages Headers Configuration
# Optimized for Chile Kayak Guide (modeled after Chilewaterlevels.com)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://chilewaterlevels.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Immutable caching for hashed static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon and PWA manifests
/favicon.svg
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400
/rivers.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
